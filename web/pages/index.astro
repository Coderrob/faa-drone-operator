---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MetricCard from "../components/MetricCard.astro";
import Icon from "../components/Icon.astro";
import { sitePath } from "../lib/paths";
---
<BaseLayout title="Part 107 Flight Desk" description="A complete FAA Part 107 certification, study, flight-practice, and compliance workspace.">
  <PageHero eyebrow="FAA Part 107 training workspace" title="Learn the rules. Prove the knowledge. Fly with discipline." description="A source-grounded path from your first FAA account to exam readiness and repeatable field compliance.">
    <div class="mt-9 flex flex-wrap gap-3">
      <a class="button-primary bg-amber-500 text-ink-950 hover:bg-amber-400" href={sitePath("/learn/certification-roadmap/")}>Start the roadmap</a>
      <a class="button-secondary border-white/25 bg-transparent text-white hover:border-sky-400 hover:text-sky-300" href={sitePath("/study/")}>Practice study cards</a>
    </div>
    <div class="mt-14 grid gap-7 border-t border-white/10 pt-8 sm:grid-cols-2 lg:grid-cols-4">
      <MetricCard value="176" label="ACS elements mapped" detail="Every parent and printed sub-element" />
      <MetricCard value="156" label="Practice questions" detail="Original, cited, and ACS-mapped" />
      <MetricCard value="2 × 60" label="Full mock exams" detail="Timed forms with remediation" />
      <MetricCard value="12" label="Worked scenarios" detail="Charts, weather, loading, night, and more" />
    </div>
  </PageHero>

  <section class="container-shell py-16 sm:py-20">
    <div class="max-w-3xl"><p class="eyebrow">One connected workflow</p><h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink-950">From applicant to accountable operator</h2><p class="mt-4 text-lg leading-8 text-slate-600">The material is sequenced around decisions you actually make—not a pile of disconnected links.</p></div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <a href={sitePath("/learn/certification-roadmap/")} class="panel group p-7 transition hover:border-sky-300"><span class="grid size-11 place-items-center rounded-lg bg-sky-50 text-sky-700"><Icon name="clipboard" /></span><h3 class="mt-5 text-xl font-bold text-ink-950">1. Get certificated</h3><p class="mt-3 text-sm leading-6 text-slate-600">Eligibility, IACRA/FTN, PSI testing, Form 8710-13, aircraft registration, and Remote ID.</p></a>
      <a href={sitePath("/learn/acs-study-guide/")} class="panel group p-7 transition hover:border-sky-300"><span class="grid size-11 place-items-center rounded-lg bg-sky-50 text-sky-700"><Icon name="book" /></span><h3 class="mt-5 text-xl font-bold text-ink-950">2. Build judgment</h3><p class="mt-3 text-sm leading-6 text-slate-600">Study every ACS objective, solve worked situations, then close weaknesses with targeted review.</p></a>
      <a href={sitePath("/learn/field-operations/")} class="panel group p-7 transition hover:border-sky-300"><span class="grid size-11 place-items-center rounded-lg bg-sky-50 text-sky-700"><Icon name="shield" /></span><h3 class="mt-5 text-xl font-bold text-ink-950">3. Operate consistently</h3><p class="mt-3 text-sm leading-6 text-slate-600">Use mission records, checklists, proficiency gates, SOPs, and compliance controls in the field.</p></a>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="container-shell grid gap-10 py-16 lg:grid-cols-[1fr_1.05fr] lg:items-center">
      <div><p class="eyebrow">Practice in the browser</p><h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink-950">Turn the complete card deck into focused sessions.</h2><p class="mt-5 text-lg leading-8 text-slate-600">Filter by ACS Area or topic, choose a repeatable seed, answer by keyboard or touch, and keep progress locally on your device.</p><div class="mt-7 flex flex-wrap gap-3"><a href={sitePath("/study/")} class="button-primary">Open study mode</a><a href={sitePath("/exam/")} class="button-secondary">Take a mock exam</a></div></div>
      <div class="rounded-2xl bg-ink-950 p-7 text-white shadow-panel"><div class="flex items-center justify-between"><span class="rounded-full bg-sky-400/15 px-3 py-1 text-xs font-bold text-sky-300">UA.II.B.K2</span><span class="text-xs text-slate-400">Question 4 of 10</span></div><p class="mt-7 font-display text-2xl font-bold leading-9">Is a UAS Facility Map grid value an authorization?</p><div class="mt-6 grid gap-3"><div class="rounded-lg border border-white/15 p-4 text-sm text-slate-300">A. Yes, it authorizes flight to the grid altitude.</div><div class="rounded-lg border-2 border-sky-400 bg-sky-400/10 p-4 text-sm font-semibold text-white">B. No, it is a planning value used in authorization processing.</div><div class="rounded-lg border border-white/15 p-4 text-sm text-slate-300">C. Only during daylight operations.</div></div></div>
    </div>
  </section>
</BaseLayout>
