---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import QuizApp from "../components/QuizApp.astro";
import manualQuestions from "../../data/questions.json";
import cardQuestions from "../../data/card-questions.json";
import type { Question } from "../../src/types";
const questions = [...manualQuestions, ...cardQuestions] as Question[];
---
<BaseLayout title="Study cards" description="Build focused, deterministic Part 107 study sessions from 156 ACS-mapped questions.">
  <PageHero compact eyebrow="Interactive study cards" title="Practice the objective—not the answer position." description="Choose an ACS Area, narrow by topic, and get immediate explanations, remediation, and authoritative sources." />
  <section class="container-shell py-12"><div class="mb-7 grid gap-4 sm:grid-cols-3"><div class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-2xl font-bold text-ink-950">156</p><p class="text-sm text-slate-600">Original questions</p></div><div class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-2xl font-bold text-ink-950">5</p><p class="text-sm text-slate-600">ACS Areas</p></div><div class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-2xl font-bold text-ink-950">Local</p><p class="text-sm text-slate-600">Private progress storage</p></div></div><QuizApp mode="study" questions={questions} /></section>
</BaseLayout>
