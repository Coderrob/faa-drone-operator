---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { repositoryUrl, sitePath } from "../lib/paths";
const resources = [
  { title: "Mission record", detail: "Planning, approval, crew, weather, risk, flight, and postflight evidence.", file: "templates/mission-record.md", slug: "mission-record" },
  { title: "Pilot & aircraft record", detail: "Certificate, registration, Remote ID, category, and configuration inventory.", file: "templates/pilot-aircraft-record.md", slug: "pilot-aircraft-record" },
  { title: "Compliance calendar", detail: "Ownership, renewal, approval, equipment, and review dates for the CLI audit.", file: "templates/compliance-calendar.csv" },
  { title: "Maintenance & battery log", detail: "Configuration, corrective work, cycles, performance, and release decisions.", file: "templates/maintenance-battery-log.csv" },
  { title: "Incident record", detail: "Preserve facts and route FAA/NTSB or other reporting decisions.", file: "templates/incident-record.md", slug: "incident-record" },
  { title: "ACS progress tracker", detail: "Track mastery and remediation across all 17 ACS Tasks.", file: "trackers/acs-progress.csv" },
];
---
<BaseLayout title="Operator resources" description="Download and use the Part 107 operational templates, trackers, and source data.">
  <PageHero compact eyebrow="Operator resources" title="Take the system into the field." description="Reusable records and trackers turn study knowledge into traceable operational decisions." />
  <section class="container-shell py-14"><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{resources.map((resource) => <a href={resource.slug ? sitePath(`/learn/${resource.slug}/`) : `${repositoryUrl}/raw/main/${resource.file}`} class="panel group flex min-h-52 flex-col p-6"><span class="grid size-10 place-items-center rounded-lg bg-sky-50 text-sky-700"><Icon name="clipboard" /></span><h2 class="mt-5 text-xl font-bold text-ink-950 group-hover:text-sky-700">{resource.title}</h2><p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{resource.detail}</p><span class="mt-5 text-sm font-bold text-sky-700">{resource.slug ? "Open template" : "Download source file"}</span></a>)}</div><div class="mt-12 rounded-2xl bg-ink-950 p-7 text-white sm:flex sm:items-center sm:justify-between"><div><h2 class="font-display text-2xl font-bold">Prefer automation?</h2><p class="mt-2 text-sm text-slate-300">The CLI audits the compliance calendar and provides terminal-based study modes.</p></div><a href={sitePath("/learn/study-cli/")} class="button-primary mt-5 bg-amber-500 text-ink-950 hover:bg-amber-400 sm:mt-0">Open CLI guide</a></div></section>
</BaseLayout>
