---
import Icon from "./Icon.astro";
import type { DocumentEntry } from "../lib/documents";
import { sitePath } from "../lib/paths";
interface Props {
  entry: DocumentEntry;
}
const { entry } = Astro.props;
---

<a href={sitePath(`/learn/${entry.slug}/`)} class="group flex min-h-56 flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-sky-300 hover:shadow-panel">
  <p class="eyebrow">{entry.eyebrow}</p>
  <h2 class="mt-3 font-display text-xl font-bold tracking-tight text-ink-950 group-hover:text-sky-700">{entry.title}</h2>
  <p class="mt-3 flex-1 text-sm leading-6 text-slate-600">{entry.summary}</p>
  <span class="mt-6 flex items-center gap-2 text-sm font-bold text-ink-900">Read guide <Icon name="chevron" class="size-4 transition group-hover:translate-x-1" /></span>
</a>
