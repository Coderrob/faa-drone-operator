---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  compact?: boolean;
}
const { eyebrow, title, description, compact = false } = Astro.props;
---

<section class:list={["relative overflow-hidden bg-ink-950 text-white", compact ? "py-12 sm:py-16" : "py-16 sm:py-24"]}>
  <div class="absolute inset-y-0 right-0 w-1/3 border-l border-white/5 bg-[linear-gradient(135deg,transparent_0_48%,rgba(73,180,229,.08)_48%_52%,transparent_52%)] bg-[length:28px_28px]"></div>
  <div class="container-shell relative">
    <p class="eyebrow text-sky-400">{eyebrow}</p>
    <h1 class:list={["mt-4 max-w-4xl font-display font-bold tracking-[-0.035em] text-balance", compact ? "text-4xl sm:text-5xl" : "text-5xl sm:text-6xl lg:text-7xl"]}>
      {title}
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">{description}</p>
    <slot />
  </div>
</section>
