{
  "bin": {
    "part107": "dist-cli/src/cli.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@uswds/uswds": "^3.14.0",
    "astro": "^7.2.8",
    "commander": "^14.0.0",
    "marked": "^18.0.10",
    "tailwindcss": "^4.3.3"
  },
  "description": "FAA Part 107 certification guide, ACS-mapped study app, mock exams, CLI, and compliance toolkit",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^54.7.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://faadroneoperator.com/",
  "keywords": [
    "faa",
    "part-107",
    "drone",
    "remote-pilot",
    "uas",
    "suas",
    "aviation",
    "study-guide",
    "mock-exam",
    "astro"
  ],
  "name": "faa-part-107-study-cli",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coderrob/faa-drone-operator.git"
  },
  "scripts": {
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:all": "npm run build:cli && npm run build",
    "build:cli": "tsc -p tsconfig.json",
    "check": "npm run quality && npm run check:cli && npm run check:astro && npm run build && npm run validate:site",
    "check:astro": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:cli": "npm run build:cli && npm test && npm run validate:content",
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "dev:cli": "tsx src/cli.ts",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "eslint src web tools e2e *.ts",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#coverage\" \"#dist*\" \"#site-dist\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run format:check && npm run lint && npm run typecheck:all && npm run test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx tools/run-e2e.ts",
    "test:watch": "vitest",
    "typecheck:all": "tsc -p tsconfig.eslint.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "validate:content": "node dist-cli/src/cli.js validate",
    "validate:site": "tsx tools/validate-site.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
