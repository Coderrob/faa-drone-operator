{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "*.ts",
    "e2e/**/*.ts",
    "src/**/*.ts",
    "tools/**/*.ts",
    "web/**/*.ts"
  ],
  "exclude": ["coverage", "dist", "dist-cli", "node_modules", "site-dist"]
}
